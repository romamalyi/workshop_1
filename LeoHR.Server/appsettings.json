{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "RequireHttpsMetadata": true,
    "ApiName": "LeoHR"
  },
  "Email": {
    "From": "noreply@leobit.co",
    "AppBaseUrl": "https://leohr.leobit.co",
    "SenderDomains": [ "leobit.com", "leobit.co" ],
    "SmtpSettings": {
      "Host": "smtp-relay.gmail.com",
      "Port": 587,
      "EnableSsl": true
    }
  },
  "Promotions": {
    "MaxLeaversPerCleanup": 10
  },
  "FeatureManagement": {
    "KnowledgeEvaluation": true,
    "EmployeeDataCache": true
  },
  "AllowedHosts": "*"
}
