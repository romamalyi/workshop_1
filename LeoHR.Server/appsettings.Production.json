{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureManagement": {
    "KnowledgeEvaluation": false
  },
  "IdentityServer": {
    "RequireHttpsMetadata": true,
    "Authority": "https://identity.leobit.co"
  },
  "Cors": {
    "AllowedOrigins": [ "https://employee.leobit.co" ]
  },
  "Email": {
    "WhitelistEnabled": false
  },
  "EmployeeApi": {
    "BaseUrl": "https://api.employee.leobit.co",
    "TimeoutSeconds": 30,
    "CacheExpirationMinutes": 60,
    "Auth": {
      "TokenEndpoint": "https://identity.leobit.co/connect/token",
      "ClientId": "leobit.leohr.service",
      "Scope": "employee"
    }
  }
}
