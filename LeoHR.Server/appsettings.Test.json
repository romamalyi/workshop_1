{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "AppBaseUrl": "https://test.leohr.leobit.co"
  },
  "FeatureManagement": {
    "EmployeeDataCache": false
  },
  "IdentityServer": {
    "RequireHttpsMetadata": false,
    "Authority": "https://test.identity.leobit.co"
  },
  "EmployeeApi": {
    "BaseUrl": "https://test.api.employee.leobit.co",
    "TimeoutSeconds": 30,
    "CacheExpirationMinutes": 60,
    "Auth": {
      "TokenEndpoint": "https://test.identity.leobit.co/connect/token",
      "ClientId": "leobit.leohr.service",
      "Scope": "employee"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://test.employee.leobit.co", "https://localhost:4200" ]
  }
}
